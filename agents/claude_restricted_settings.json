{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/credentials)",
      "Read(**/credentials*.json)",
      "Read(**/auth.json)",
      "Read(**/.credentials.json)",
      "Read(**/id_rsa*)",
      "Read(**/id_dsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.ssh/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.git-credentials)",
      "Read(**/.cdp-profile/**)",
      "Read(**/keys/**)",
      "Read(**/*secret*)"
    ]
  }
}
